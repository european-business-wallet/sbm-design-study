            "forwarding_rdp_id": {
              "$ref": "schemas/evidence-common.schema.json#/$defs/RdpId"
            },
            "issuing_rdp_id": {
              "$ref": "schemas/evidence-common.schema.json#/$defs/RdpId"
            },
            "message_id": {
              "type": "string"
            },
