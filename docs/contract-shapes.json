              "$ref": "schemas/evidence-common.schema.json#/$defs/EnvelopeHash"
            },
            "message_id": {
              "type": "string"
            },
            "mls_group_id": {
              "type": "string"
            },
            "mls_message_b64": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "transferred"
            }
          }
        },
        "CollectionToken": {
          "type": "string",
          "minLength": 8
        },
        "DeliveryItemState": {
          "type": "string",
          "enum": [
            "accepted",
            "queued",
            "transferred",
            "acknowledged"
          ]
        },
        "DeliveryReceipt": {
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "device_id",
            "ds_alg",
            "ds_kid",
            "ds_signature",
            "issuing_rdp_id",
            "message_digest",
            "message_id",
            "mid",
            "recipient_uid",
            "server_time",
            "session_binding"
          ],
          "properties": {
            "client_acked_at": {
              "type": "string",
              "format": "date-time"
            },
            "device_id": {
              "type": "string"
            },
            "ds_alg": {
              "type": "string",
              "enum": [
                "EdDSA",
                "ES256",
                "ES384"
